import os
from os.path import join as path_join
from nestly import Nest
from nestly.scons import SConsWrap
from SCons.Script import Import

Import("env")
localenv = env.Clone()

# SLURM configuration
USE_SLURM = env["use_slurm"]
SRUN_PREFIX = "srun --cpus-per-task=2 --mem=5G"

# Debug mode: save per-iteration predictions and sampler state
DEBUG_MODE = False

# Paths to data files (copied from Social Wayfinder project)
LLM_ANNOTATIONS_CSV = "data/sdoh_llm_annotated_notes.csv"
HUMAN_ANNOTATIONS_CSV = "data/sdoh_human_annotations.csv"

EMBEDDING_MODEL = "sentence-transformers/allenai-specter"

# E-detector parameters
# Overall LLM-human agreement is ~88% (after excluding irrelevant all-zero codes),
# so null says all subgroups >= 85%
# Failure categories range from 58% (high prioritization) to 83% (admission reason)
NULL_PROB = 0.83
ALPHA = 0.05

# Nonadaptive alternative probabilities
MODEL_ALT_PROB = 0.80
AUDITOR_ALT_PROB = 0.86

# Mixture e-detector grids
MIXTURE_GRID_LOW = 0.60       # robustness grid: all points < NULL_PROB
MIXTURE_GRID_HIGH = 0.80
MIXTURE_GRID_STEP = 0.05
AUDITOR_MIXTURE_GRID_LOW = 0.86   # auditor grid: all points > NULL_PROB
AUDITOR_MIXTURE_GRID_HIGH = 0.97
AUDITOR_MIXTURE_GRID_STEP = 0.03

# EWAF learning rate
EWAF_LEARNING_RATE = 0.2

# Active sampler parameters
NUM_NNS = 20
HIDDEN_DIMS = [5, 10]
NUM_EPOCHS = "2 4 8 16"
LEARNING_RATE = 0.01
EPSILON = 0.05
NUM_REQUIRE_ITERS = 100

LEARNED_NUM_INIT = 40

# Class weight parameters for active sampler
CLASS_WEIGHT_0 = 1.0
CLASS_WEIGHT_1 = 1.0

ACTIVE_METHODS = [
    "sr", "sr_adaptive", "sprt_adaptive", "sr_mixture", "sprt_mixture", "sr_ewaf", "sprt_ewaf"]
FIXED_SAMPLING_SCHEMES = [
    "oracle",
    "learned",
    "stratified",
]

nest = SConsWrap(Nest(), "_output", alias_environment=localenv)

nest.add_aggregate('agg_res', list)
nest.add_aggregate('agg_history_csvs', list)

nest.add(
    "embed_mode",
    [
        #"definition_only",
        "definition_note"
    ],
    label_func=lambda c: f"embed_{c}",
)

@nest.add_target_with_env(localenv)
def assemble_data(env, outdir, c):
    """Assemble SDoH data from human vs LLM comparison"""

    cmd = [
        "python", "src/assemble_sdoh_data.py",
        "--llm-annotations-csv", LLM_ANNOTATIONS_CSV,
        "--human-annotations-csv", HUMAN_ANNOTATIONS_CSV,
        "--embed-mode", c["embed_mode"],
        "--out-csv", "${TARGETS[0]}",
        "--out-summary-csv", "${TARGETS[1]}",
    ]
    targets = [
        path_join(outdir, "sdoh_data.csv"),
        path_join(outdir, "sdoh_summary.csv"),
    ]

    return env.Command(
        targets,
        [],
        " ".join(map(str, cmd))
    )

@nest.add_target_with_env(localenv)
def assemble_embeddings(env, outdir, c):
    """Pre-compute embeddings once (shared across all seeds/methods/samplers)"""

    cmd = [
        "python", "src/embed_data.py",
        "--in-csv", "${SOURCES[0]}",
        "--out-csv", "${TARGETS[0]}",
        "--model", EMBEDDING_MODEL,
    ]
    targets = [
        path_join(outdir, "embeddings.csv"),
    ]

    full_cmd = " ".join(map(str, cmd))

    return env.Command(
        targets,
        c["assemble_data"],
        full_cmd
    )

nest.add(
    "max_samples",
    [400],
    label_func=lambda c: f"max_samples_{c}",
)

nest.add(
    "num_init",
    [
        20
    ],
    label_func=lambda c: f"num_init_{c}",
)

nest.add(
    "seed",
    range(40),
    label_func=lambda c: f"seed_{c}",
)

nest.add(
    "method",
    [
        "sprt",  # fixed (bad) choice
        "sprt_ewaf",  # grid
        "sr",  # changepoint, fixed
        "sr_ewaf",  # changepoint, grid
    ],
    label_func=lambda c: f"method_{c}",
)

nest.add(
    "sampler_type",
    lambda c: [
        "active",
    ] if c["method"] in ACTIVE_METHODS else [
        "active",
        "oracle",
        "learned",
        "stratified",
    ],
    label_func=lambda c: f"sampler_{c}",
)

nest.add(
    "allow_label_only",
    [
        False,
    ],
    label_func=lambda c: "label_only" if c else "no_label_only",
)

nest.add(
    "m_min",
    lambda c: (
        [1] if c["sampler_type"] in FIXED_SAMPLING_SCHEMES else [80]
    ),
    label_func=lambda c: f"m_min_{c}",
)

nest.add(
    "alt_prob",
    lambda c: ([NULL_PROB] if "adaptive" in c["method"] or "mixture" in c["method"] or "ewaf" in c["method"] else [MODEL_ALT_PROB]),
    label_func=lambda c: f"alt_prob_{c:.3f}",
)


@nest.add_target_with_env(localenv)
def run_e_test(env, outdir, c):
    """Run e-test on SDoH data"""

    use_adaptive = "adaptive" in c["method"]
    use_mixture = "mixture" in c["method"]
    use_ewaf = "ewaf" in c["method"]
    actual_sampler_type = c["sampler_type"]
    base_method = c["method"].replace("_adaptive", "").replace("_mixture", "").replace("_ewaf", "")

    cmd = [
        "python", "src/do_e_test.py",
        "--seed", c["seed"] + 1,
        "--in-data-csv", "${SOURCES[0]}",
        "--in-embeddings-csv", "${SOURCES[1]}",
        "--history", "${TARGETS[0]}",
        "--result-csv", "${TARGETS[1]}",
        "--log", "${TARGETS[2]}",
        "--test-type dual",
        "--tester-type standard",
        "--sampler-type", actual_sampler_type,
        "--method", base_method,
        "--null-prob", NULL_PROB,
        "--alt-prob", c["alt_prob"],
        "--alpha", ALPHA,
        "--m-min", c["m_min"],
        "--l2-penalty 0",
        "--adaptive" if use_adaptive else "",
        "--mixture" if use_mixture else "",
        "--ewaf" if use_ewaf else "",
        "--iter-require-test", c["max_samples"] - NUM_REQUIRE_ITERS,
        "--allow-label-only" if c["allow_label_only"] else "",
    ]

    targets = [
        path_join(outdir, "history.csv"),
        path_join(outdir, "result.csv"),
        path_join(outdir, "log.txt") if "ewaf" in c["method"] else path_join(outdir, "log_ucb50.txt"),
    ]

    # Debug options: save per-iteration predictions and sampler state
    if DEBUG_MODE and c["seed"] == 0:
        debug_pred_dir = path_join("exp_sdoh", outdir, "debug_predictions")
        debug_sampler_dir = path_join("exp_sdoh", outdir, "debug_samplers")
        cmd.extend([
            "--debug-pred-dir", debug_pred_dir,
            "--debug-sampler-dir", debug_sampler_dir,
        ])

    # Add auditor-alt-prob for non-adaptive, non-mixture methods
    if not use_adaptive and not use_mixture:
        cmd.extend(["--auditor-alt-prob", AUDITOR_ALT_PROB])
    if use_mixture:
        cmd.extend([
            "--grid-low", MIXTURE_GRID_LOW,
            "--grid-high", MIXTURE_GRID_HIGH,
            "--grid-step", MIXTURE_GRID_STEP,
            "--auditor-grid-low", AUDITOR_MIXTURE_GRID_LOW,
            "--auditor-grid-high", AUDITOR_MIXTURE_GRID_HIGH,
            "--auditor-grid-step", AUDITOR_MIXTURE_GRID_STEP,
        ])
    if use_ewaf:
        cmd.extend([
            "--grid-low", MIXTURE_GRID_LOW,
            "--grid-high", MIXTURE_GRID_HIGH,
            "--grid-step", MIXTURE_GRID_STEP,
            "--auditor-grid-low", AUDITOR_MIXTURE_GRID_LOW,
            "--auditor-grid-high", AUDITOR_MIXTURE_GRID_HIGH,
            "--auditor-grid-step", AUDITOR_MIXTURE_GRID_STEP,
            "--ewaf-learning-rate", EWAF_LEARNING_RATE,
        ])

    if c["sampler_type"] == "active":
        cmd.extend([
            "--num-nns", NUM_NNS,
            f"--hidden-dims {' '.join(map(str, HIDDEN_DIMS))}",
            "--epsilon", EPSILON,
            "--num-epochs", NUM_EPOCHS,
            "--learning-rate", LEARNING_RATE,
            "--num-init", c["num_init"],
            "--max-samples", c["max_samples"],
            "--class-weight-0", CLASS_WEIGHT_0,
            "--class-weight-1", CLASS_WEIGHT_1,
        ])
    elif c["sampler_type"] == "stratified":
        cmd.extend([
            "--stratify-by", "category",
            "--max-samples", c["max_samples"],
        ])
    elif c["sampler_type"] == "oracle":
        cmd.extend([
            "--stratify-by", "category",
            "--oracle-stratum", '"high prioritization"',
            "--max-samples", c["max_samples"],
        ])
    elif c["sampler_type"] == "learned":
        cmd.extend([
            "--num-nns", NUM_NNS,
            f"--hidden-dims {' '.join(map(str, HIDDEN_DIMS))}" if HIDDEN_DIMS else "",
            "--epsilon", EPSILON,
            "--num-epochs", NUM_EPOCHS,
            "--learning-rate", LEARNING_RATE,
            "--num-init", LEARNED_NUM_INIT + c["num_init"],
            "--max-samples", c["max_samples"],
        ])
    elif c["sampler_type"] == "iid":
        cmd.extend([
            "--max-samples", c["max_samples"],
        ])
    else:
        raise NotImplementedError(f"what sampler is this? {c['sampler_type']}")

    c['agg_res'].append(targets[1])
    c['agg_history_csvs'].append(targets[0])

    full_cmd = " ".join(map(str, cmd))
    if USE_SLURM:
        full_cmd = f"{SRUN_PREFIX} {full_cmd}"

    return env.Command(
        targets,
        [c["assemble_data"][0], c["assemble_embeddings"][0]],
        full_cmd
    )

@nest.add_target_with_env(localenv)
def plot_e_process(env, outdir, c):
    """Plot e-process for seed=0 only"""
    if c["seed"] > 10 or c["method"] != "sr_ewaf":
        return None

    cmd = [
        "python", "src/plot_e_process.py",
        "--history-csv", "${SOURCES[0]}",
        "--alpha", ALPHA,
        "--m-min", c["m_min"],
        "--out-plot", "${TARGETS[0]}",
    ]
    targets = [path_join(outdir, "e_statistic.png")]

    return env.Command(
        targets,
        [c["run_e_test"][0]],  # history.csv is first target of run_e_test
        " ".join(map(str, cmd))
    )

nest.pop('seed')

@nest.add_target_with_env(localenv)
def aggregate_results(env, outdir, c):
    """Aggregate results across seeds"""
    cmd = [
        "python", "src/aggregate_results.py",
        "--input-csv", "${SOURCES}",
        "--out-csv", "${TARGETS[0]}",
        "--groupby-cols", "label", "method",
    ]
    targets = [path_join(outdir, "agg_result.csv")]

    return env.Command(
        targets,
        c["agg_res"],
        " ".join(map(str, cmd))
    )

@nest.add_target_with_env(localenv)
def plot_agg_res(env, outdir, c):
    """Plot rejection rates across methods"""
    sources = c["agg_res"]
    csv_refs = " ".join([path_join("exp_sdoh", csv_file.replace("seed_0", "seed_*")) for csv_file in sources if "seed_0" in csv_file])

    cmd = [
        "python", "src/plot_aggregate_results.py",
        "--data-setting", "sdoh", csv_refs,
        "--group-col", "method",
        "--y-max 455",
        "--out-plot-power", "${TARGETS[0]}",
        "--out-plot-obs", "${TARGETS[1]}",
        "--out-csv", "${TARGETS[2]}",
        "--out-legend", "${TARGETS[3]}",
    ]
    targets = [
        path_join(outdir, "plot_agg_power.png"),
        path_join(outdir, "plot_agg_obs.png"),
        path_join(outdir, "agg_res_out.csv"),
        path_join(outdir, "plot_legend.png"),
    ]

    return env.Command(
        targets,
        sources,
        " ".join(map(str, cmd))
    )

@nest.add_target_with_env(localenv)
def plot_sdoh_sampling(env, outdir, c):
    """Analyze sampling frequency by category for sr_ewaf"""
    # Filter history csvs to only sr_ewaf runs
    sr_ewaf_histories = [
        h for h in c["agg_history_csvs"] if "method_sr_ewaf" in h
    ]
    if not sr_ewaf_histories:
        return None

    # Use glob pattern to capture all seeds
    csv_refs = " ".join([
        path_join("exp_sdoh", csv_file.replace("seed_0", "seed_*"))
        for csv_file in sr_ewaf_histories if "seed_0" in csv_file
    ])

    cmd = [
        "python", "src/plot_exp_sdoh.py",
        "--sdoh-summary-csv", "${SOURCES[0]}",
        "--history-csvs", csv_refs,
        "--out-csv", "${TARGETS[0]}",
        "--out-plot", "${TARGETS[1]}",
        "--log", "${TARGETS[2]}",
    ]
    targets = [
        path_join(outdir, "sdoh_sampling_analysis.csv"),
        path_join(outdir, "sdoh_sampling_scatter.png"),
        path_join(outdir, "log_sdoh_sampling_analysis.txt"),
    ]

    return env.Command(
        targets,
        [c["assemble_data"][1]] + sr_ewaf_histories,
        " ".join(map(str, cmd))
    )
